<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- BABYLON SCORE: Hermès × Iraqi Heritage Color Palette -->

    <!-- Core Babylon Palette -->
    <Color x:Key="BabylonBlue">#1F4E8C</Color>
    <Color x:Key="BabylonBlueDark">#153662</Color>
    <Color x:Key="BabylonBlueLight">#2A6BB8</Color>
    <Color x:Key="Gold">#C9A84C</Color>
    <Color x:Key="GoldLight">#E0C878</Color>
    <Color x:Key="GoldDark">#A88A2E</Color>
    <Color x:Key="TerraCotta">#B85D3F</Color>
    <Color x:Key="TerraCottaLight">#D47A5C</Color>
    <Color x:Key="Ivory">#F5F0E8</Color>
    <Color x:Key="Cream">#FAF7F2</Color>
    <Color x:Key="Obsidian">#1A1A1A</Color>
    <Color x:Key="Charcoal">#2A2A2A</Color>
    <Color x:Key="WarmGray">#8B8580</Color>
    <Color x:Key="Mist">#E8E4DC</Color>

    <!-- Surface Colors -->
    <Color x:Key="SurfaceLight">#FAF7F2</Color>
    <Color x:Key="SurfaceDark">#121212</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#1E1E1E</Color>
    <Color x:Key="SurfaceVariant">#E8E4DC</Color>
    <Color x:Key="SurfaceVariantDark">#2A2A2A</Color>

    <!-- Text Colors -->
    <Color x:Key="OnSurface">#1A1A1A</Color>
    <Color x:Key="OnSurfaceDark">#F0EDE8</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="OnSurfaceVariant">#8B8580</Color>
    <Color x:Key="OnSurfaceVariantDark">#9A958F</Color>

    <!-- Borders -->
    <Color x:Key="OutlineLight">#D4CFC8</Color>
    <Color x:Key="OutlineDark">#3A3A3A</Color>

    <!-- Semantic aliases (literal values to avoid StaticResource chain in source gen) -->
    <Color x:Key="Primary">#1F4E8C</Color>
    <Color x:Key="PrimaryLight">#2A6BB8</Color>
    <Color x:Key="PrimaryDark">#153662</Color>
    <Color x:Key="Accent">#B85D3F</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1F4E8C"/>
    <SolidColorBrush x:Key="GoldBrush" Color="#C9A84C"/>
    <SolidColorBrush x:Key="TerraCottaBrush" Color="#B85D3F"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FAF7F2"/>
    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="#121212"/>
</ResourceDictionary>

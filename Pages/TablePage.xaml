<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:BabylonScore.Services"
             xmlns:models="clr-namespace:BabylonScore.Models"
             x:Class="BabylonScore.Pages.TablePage"
             Title="TABLE"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">

    <Grid RowDefinitions="Auto,*" FlowDirection="{Binding FlowDirection, Source={x:Static services:LocalizationManager.Instance}}">
        
        <!-- Table column headers -->
        <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="{StaticResource BabylonBlue}" Padding="16,8">
            <Grid ColumnDefinitions="30,*,40,30,30,30,40" ColumnSpacing="2">
                <Label Grid.Column="0" Text="#" TextColor="{StaticResource Gold}" FontAttributes="Bold" FontSize="11" />
                <Label Grid.Column="1" Text="Team" TextColor="{StaticResource Gold}" FontAttributes="Bold" FontSize="11" />
                <Label Grid.Column="2" Text="Pl" TextColor="{StaticResource Gold}" FontAttributes="Bold" FontSize="11" HorizontalTextAlignment="Center" />
                <Label Grid.Column="3" Text="W" TextColor="{StaticResource Gold}" FontAttributes="Bold" FontSize="11" HorizontalTextAlignment="Center" />
                <Label Grid.Column="4" Text="D" TextColor="{StaticResource Gold}" FontAttributes="Bold" FontSize="11" HorizontalTextAlignment="Center" />
                <Label Grid.Column="5" Text="L" TextColor="{StaticResource Gold}" FontAttributes="Bold" FontSize="11" HorizontalTextAlignment="Center" />
                <Label Grid.Column="6" Text="Pts" TextColor="{StaticResource GoldLight}" FontAttributes="Bold" FontSize="11" HorizontalTextAlignment="Center" />
            </Grid>
        </Border>

        <CollectionView x:Name="StandingsList" Grid.Row="1" Margin="16,12">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Standing">
                    <Border Stroke="{StaticResource OutlineLight}" StrokeThickness="0.5"
                            StrokeShape="RoundRectangle 8" Padding="12,8" Margin="0,0,0,6"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">
                        <Grid ColumnDefinitions="30,*,40,30,30,30,40" ColumnSpacing="2" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="{Binding Rank}" FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Image Source="{Binding TeamFlag}" HeightRequest="14" WidthRequest="20" Aspect="AspectFit" />
                                <Label Text="{Binding TeamName}" FontSize="12" FontAttributes="Bold"
                                       TextColor="{StaticResource OnSurface}" LineBreakMode="TailTruncation" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="2" Text="{Binding Played}" FontSize="11"
                                   TextColor="{StaticResource OnSurfaceVariant}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="3" Text="{Binding Won}" FontSize="11"
                                   TextColor="{StaticResource OnSurfaceVariant}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="4" Text="{Binding Drawn}" FontSize="11"
                                   TextColor="{StaticResource OnSurfaceVariant}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="5" Text="{Binding Lost}" FontSize="11"
                                   TextColor="{StaticResource OnSurfaceVariant}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="6" Text="{Binding Points}" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource Gold}" HorizontalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:BabylonScore.Models"
             x:Class="BabylonScore.Pages.MatchDetailPage"
             Title="Match Details"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Match Hero Scoreboard -->
            <Grid HeightRequest="200" Padding="20" BackgroundColor="{StaticResource BabylonBlue}">
                <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="4" VerticalOptions="Center">

                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" HorizontalOptions="Center" Spacing="8">
                        <Border Stroke="{StaticResource Gold}" StrokeThickness="0.5" StrokeShape="RoundRectangle 28"
                                WidthRequest="56" HeightRequest="56" Padding="0"
                                BackgroundColor="{StaticResource SurfaceLight}">
                            <Image x:Name="HomeFlagImg" HeightRequest="36" WidthRequest="36"
                                   Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label x:Name="HomeTeamLabel" FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource OnPrimary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                        <Label x:Name="ScoreLabel" FontSize="42" FontAttributes="Bold"
                               TextColor="{StaticResource Gold}" FontFamily="Georgia"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="StatusLabel" FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource TerraCottaLight}"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="RoundLabel" FontSize="10"
                               TextColor="{StaticResource OnPrimary}" Opacity="0.7"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="0" Grid.Column="2" HorizontalOptions="Center" Spacing="8">
                        <Border Stroke="{StaticResource Gold}" StrokeThickness="0.5" StrokeShape="RoundRectangle 28"
                                WidthRequest="56" HeightRequest="56" Padding="0"
                                BackgroundColor="{StaticResource SurfaceLight}">
                            <Image x:Name="AwayFlagImg" HeightRequest="36" WidthRequest="36"
                                   Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label x:Name="AwayTeamLabel" FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource OnPrimary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <Label x:Name="VenueLabel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                           FontSize="10" TextColor="{StaticResource OnPrimary}" Opacity="0.6"
                           HorizontalTextAlignment="Center" Margin="0,8,0,0" />
                </Grid>
            </Grid>

            <!-- Match Stats -->
            <Label Text="MATCH STATS" FontSize="14" FontAttributes="Bold"
                   TextColor="{StaticResource Gold}" FontFamily="Georgia"
                   Margin="20,16,20,8" />

            <VerticalStackLayout x:Name="StatsContainer" Margin="20,0" Spacing="12" />

            <!-- Live Events -->
            <Label Text="LIVE EVENTS" FontSize="14" FontAttributes="Bold"
                   TextColor="{StaticResource Gold}" FontFamily="Georgia"
                   Margin="20,16,20,8" />
            <Label Text="No events yet" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}"
                   Margin="20,0,20,20" HorizontalTextAlignment="Center" />

            <!-- Head to Head -->
            <Label Text="HEAD TO HEAD" FontSize="14" FontAttributes="Bold"
                   TextColor="{StaticResource Gold}" FontFamily="Georgia"
                   Margin="20,8,20,8" />
            <Border Stroke="{StaticResource OutlineLight}" StrokeThickness="0.5" StrokeShape="RoundRectangle 8"
                    Margin="20,0,20,20" Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">
                <Grid ColumnDefinitions="*,Auto,*">
                <Label x:Name="H2HHomeLabel" Grid.Column="0" FontSize="24" FontAttributes="Bold"
                       TextColor="{StaticResource OnSurface}" HorizontalTextAlignment="Center" />
                <Label Grid.Column="1" Text="-" FontSize="20" TextColor="{StaticResource OnSurfaceVariant}"
                       HorizontalTextAlignment="Center" Margin="12,0" VerticalTextAlignment="Center" />
                <Label x:Name="H2HAwayLabel" Grid.Column="2" FontSize="24" FontAttributes="Bold"
                       TextColor="{StaticResource OnSurface}" HorizontalTextAlignment="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

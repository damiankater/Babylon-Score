<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BabylonScore.Controls"
             xmlns:models="clr-namespace:BabylonScore.Models"
             x:Class="BabylonScore.Pages.MatchesPage"
             Title="MATCHES"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">

    <Grid RowDefinitions="Auto,*">
        <!-- Filter Bar -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8" Padding="16,16,16,8">
            <Button Text="All" FontSize="12" CornerRadius="16"
                    BackgroundColor="{StaticResource Gold}" TextColor="{StaticResource OnPrimary}"
                    HeightRequest="32" Padding="12,0" Clicked="OnFilterClicked" />
            <Button Text="Live" FontSize="12" CornerRadius="16"
                    BackgroundColor="{StaticResource SurfaceVariant}" TextColor="{StaticResource OnSurface}"
                    HeightRequest="32" Padding="12,0" Clicked="OnFilterClicked" />
            <Button Text="Today" FontSize="12" CornerRadius="16"
                    BackgroundColor="{StaticResource SurfaceVariant}" TextColor="{StaticResource OnSurface}"
                    HeightRequest="32" Padding="12,0" Clicked="OnFilterClicked" />
            <Button Text="Groups" FontSize="12" CornerRadius="16"
                    BackgroundColor="{StaticResource SurfaceVariant}" TextColor="{StaticResource OnSurface}"
                    HeightRequest="32" Padding="12,0" Clicked="OnFilterClicked" />
        </HorizontalStackLayout>

        <!-- Match List -->
        <CollectionView x:Name="AllMatchesList" Grid.Row="1" Margin="16,8,16,0"
                        SelectionMode="Single" SelectionChanged="OnMatchSelected">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Key}" FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource Gold}" FontFamily="Georgia"
                           Margin="0,12,0,6" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Match">
                    <controls:LuxuryMatchCard />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:BabylonScore.Services"
             xmlns:models="clr-namespace:BabylonScore.Models"
             x:Class="BabylonScore.Pages.MatchesPage"
             Title="MATCHES"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">

    <Grid RowDefinitions="Auto,*" FlowDirection="{Binding FlowDirection, Source={x:Static services:LocalizationManager.Instance}}">
        
        <!-- Premium Header tab bar style -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8" Padding="16,16,16,8">
            <Button x:Name="AllFilterBtn" Text="All Matches / الكل" FontSize="11" CornerRadius="16"
                    BackgroundColor="{StaticResource Gold}" TextColor="Black"
                    HeightRequest="32" Padding="12,0" Clicked="OnAllFilterClicked" />
            <Button x:Name="LiveFilterBtn" Text="Live / مباشر" FontSize="11" CornerRadius="16"
                    BackgroundColor="{StaticResource SurfaceVariant}" TextColor="{StaticResource OnSurface}"
                    HeightRequest="32" Padding="12,0" Clicked="OnLiveFilterClicked" />
        </HorizontalStackLayout>

        <!-- Match List -->
        <CollectionView x:Name="AllMatchesList" Grid.Row="1" Margin="16,8,16,0"
                        SelectionMode="Single" SelectionChanged="OnMatchSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Match">
                    <Border Stroke="{StaticResource Gold}" StrokeThickness="0.5" StrokeShape="RoundRectangle 12" Margin="0,0,0,10" Padding="14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,80,*">
                            <!-- Home Team -->
                            <VerticalStackLayout Grid.Column="0" Spacing="6" HorizontalOptions="Center">
                                <Image Source="{Binding HomeFlag}" WidthRequest="28" HeightRequest="28" Aspect="AspectFit" />
                                <Label Text="{Binding HomeTeam}" TextColor="{StaticResource OnSurface}" FontAttributes="Bold" FontSize="11" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            
                            <!-- Score -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding ScoreDisplay}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Gold}" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding Minute}" FontSize="9" TextColor="{StaticResource TerraCotta}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>

                            <!-- Away Team -->
                            <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center">
                                <Image Source="{Binding AwayFlag}" WidthRequest="28" HeightRequest="28" Aspect="AspectFit" />
                                <Label Text="{Binding AwayTeam}" TextColor="{StaticResource OnSurface}" FontAttributes="Bold" FontSize="11" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>

                            <!-- League Info -->
                            <Label Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding LeagueName}" FontSize="9" TextColor="{StaticResource WarmGray}" HorizontalTextAlignment="Center" Margin="0,6,0,0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BabylonScore.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:BabylonScore.Pages"
    Title="Babylon Score">

    <TabBar>
        <ShellContent
            Title="HOME"
            ContentTemplate="{DataTemplate pages:HomePage}"
            Route="home" />

        <ShellContent
            Title="MATCHES"
            ContentTemplate="{DataTemplate pages:MatchesPage}"
            Route="matches" />

        <ShellContent
            Title="TABLE"
            ContentTemplate="{DataTemplate pages:TablePage}"
            Route="table" />

        <ShellContent
            Title="HISTORY"
            ContentTemplate="{DataTemplate pages:HistoryPage}"
            Route="history" />
    </TabBar>

</Shell>
